# === Identity ===
MY_USER_ID=123456789
MY_TELEGRAM_FROM_ID=user123456789

# === LLM (generation chain: Gemini → fallback Gemini → Groq → Cohere → OpenRouter) ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_FALLBACK=your_secondary_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
LLM_MAX_INPUT_TOKENS=100000
LLM_RETRY_BASE_SECONDS=5

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
# Server-only key: Legacy "service_role" JWT OR new "Secret" key (sb_secret_...).
# Dashboard → Settings → API Keys → Secret keys (eye icon) OR tab "Legacy anon, service_role".
# NOT the publishable / anon key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key_here

# === Telegram Bot (Phase 3) ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=-1001234567890
CHANNEL_SYNC_ENABLED=true
CHANNEL_MIN_POST_CHARS=80

# === Embeddings (orchestrator / identity) ===
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
# Prefer a key from a separate Google Cloud project so embedding imports do not
# consume the generation quota. If empty, the two general Gemini keys are used.
GEMINI_EMBEDDING_API_KEY=your_embedding_project_gemini_key_here
GEMINI_EMBEDDING_API_KEY_FALLBACK=
RECENCY_LAMBDA=0.002
KNOWLEDGE_SIMILARITY_THRESHOLD=0.62
KNOWLEDGE_RETRIEVAL_LIMIT=5
CONTEXT_MAX_CHARS=30000
PERSONA_RULE_LIMIT=20
VOICE_EXAMPLE_LIMIT=6
EXPERIENCE_LIMIT=4
SEMANTIC_CHUNKER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GEMINI_RATE_LIMIT_SLEEP=15

# === Books pipeline (Cohere — profile extraction + RAG embeddings) ===
COHERE_API_KEY=your_cohere_api_key_here
COHERE_API_KEY_FALLBACK=your_secondary_cohere_api_key_here
COHERE_BOOKS_MODEL=command-r-plus-08-2024
# LLM fallback tier (after Groq): context-safe generation
COHERE_LLM_MODEL=command-r-plus-08-2024
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0
COHERE_RATE_LIMIT_SLEEP=10
# Cohere Trial embed limit: 10 RPM — keep >= 6.0s between requests
COHERE_EMBED_BATCH_SLEEP=6.5

# === Studio API (Next.js control panel) ===
STUDIO_API_SECRET=generate_a_long_random_secret_here

# === YouTube ingest (Telegram bot) ===
YOUTUBE_CAPTION_LANGUAGES=ru,en
YOUTUBE_AUDIO_CHUNK_SECONDS=600
YOUTUBE_MAX_SUMMARY_CHARS=60000
YOUTUBE_INGEST_TIMEOUT_SECONDS=900
SUPADATA_API_KEY=your_supadata_api_key_here

# === Hugging Face Spaces (optional) ===
PORT=7860
# HF_TOKEN=your_hf_token_if_needed
